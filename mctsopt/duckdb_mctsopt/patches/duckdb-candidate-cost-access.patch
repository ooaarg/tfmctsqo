+optional_ptr<DPJoinNode> JoinOrderSearchContext::EmitPairWithSampledCost(
+    JoinRelationSet &left, JoinRelationSet &right, const vector<reference<NeighborInfo>> &connections,
+    double sampled_left_cost, double sampled_right_cost, JoinOrderSampledCost &sampled_cost) {
+	sampled_cost = JoinOrderSampledCost();
+	auto plan = EmitPair(left, right, connections);
+	if (!plan) {
+		return nullptr;
+	}
+	// Empty inputs use the native resolved cache, including any newly created cross-product edge.
+	auto &resolved = connections.empty() ? enumerator.GetConnections(left, right) : connections;
+	vector<reference<NeighborInfo>> applicable;
+	for (auto &connection : resolved) {
+		if (IsConnectionApplicable(connection, left, right)) {
+			applicable.push_back(connection);
+		}
+	}
+	// The pair is already emitted; an uncached term only means there is nothing to observe.
+	if (!enumerator.cost_model.TryGetCachedLocalCost(plan->set, applicable, sampled_cost.cardinality,
+	                                                 sampled_cost.left_input_cost)) {
+		return plan;
+	}
+	sampled_cost.cost = CostModel::CombineCost(sampled_cost.cardinality, sampled_cost.left_input_cost,
+	                                           sampled_left_cost, sampled_right_cost);
+	sampled_cost.valid = std::isfinite(sampled_cost.cost);
+	return plan;
+}
