+JoinOrderMemoCostDiagnostics JoinOrderSearchContext::DiagnoseMemoCost(JoinRelationSet &set) const {
+	JoinOrderMemoCostDiagnostics result;
+	result.stored_cost = GetPlan(set).cost;
+	std::function<double(JoinRelationSet &)> recost = [&](JoinRelationSet &current) -> double {
+		auto &node = GetPlan(current);
+		result.nodes++;
+		if (!std::isfinite(node.cost)) {
+			result.complete = false;
+			result.invalid_nodes++;
+		}
+		if (node.is_leaf) {
+			return node.cost;
+		}
+		auto left_cost = recost(node.left_set);
+		auto right_cost = recost(node.right_set);
+		if (!std::isfinite(left_cost) || !std::isfinite(right_cost)) {
+			// Counted where it arose; every ancestor would otherwise count the same fault again.
+			return NAN;
+		}
+		vector<reference<NeighborInfo>> applicable;
+		for (auto &connection : GetQueryGraph().GetConnections(node.left_set, node.right_set)) {
+			if (IsConnectionApplicable(connection, node.left_set, node.right_set)) {
+				applicable.push_back(connection);
+			}
+		}
+		double join_cardinality = 0;
+		double left_input_cost = 0;
+		if (!enumerator.cost_model.TryGetCachedLocalCost(current, applicable, join_cardinality, left_input_cost)) {
+			result.complete = false;
+			result.missing_estimates++;
+			return NAN;
+		}
+		result.left_input_cost += left_input_cost;
+		result.left_cost_nodes += left_input_cost != 0;
+		result.fractional_cardinality_nodes += join_cardinality != std::floor(join_cardinality);
+		auto cost = CostModel::CombineCost(join_cardinality, left_input_cost, left_cost, right_cost);
+		if (!std::isfinite(cost)) {
+			result.complete = false;
+			result.invalid_nodes++;
+			return cost;
+		}
+		auto gap = std::abs(node.cost - cost);
+		auto scale = MaxValue(1.0, MaxValue(std::abs(node.cost), std::abs(cost)));
+		// Ignore floating-point summation noise, while retaining the measured maximum gap.
+		result.stale_nodes += gap > 1e-10 * scale;
+		result.max_absolute_gap = MaxValue(result.max_absolute_gap, gap);
+		result.max_relative_gap = MaxValue(result.max_relative_gap, gap / scale);
+		return cost;
+	};
+	result.recosted_cost = recost(set);
+	return result;
+}
