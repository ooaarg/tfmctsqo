+bool JoinOrderSearchContext::HasCompletePlan() const {
+	return bool(CompleteRelation());
+}
+optional_ptr<JoinRelationSet> JoinOrderSearchContext::CompleteRelation() const {
+	for (auto &entry : enumerator.plans) {
+		if (entry.first.get().count == RelationCount()) {
+			return &entry.second->set;
+		}
+	}
+	return nullptr;
+}
+static string MemoSignature(const JoinOrderSearchContext &context, JoinRelationSet &set) {
+	auto &node = context.GetPlan(set);
+	if (node.is_leaf) {
+		return set.ToString();
+	}
+	return "(" + MemoSignature(context, node.left_set) + "," + MemoSignature(context, node.right_set) + ")";
+}
+string JoinOrderSearchContext::BestPlanSignature() const {
+	auto complete = CompleteRelation();
+	return complete ? MemoSignature(*this, *complete) : "";
+}
