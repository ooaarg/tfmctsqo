diff --git a/test/optimizer/join_order_extension.cpp b/test/optimizer/join_order_extension.cpp
new file mode 100644
index 0000000000..fcc3bd2edf
--- /dev/null
+++ b/test/optimizer/join_order_extension.cpp
@@ -0,0 +1,210 @@
+#include "duckdb.hpp"
+#include "duckdb/main/config.hpp"
+#include "duckdb/main/client_context.hpp"
+#include <stdexcept>
+#include "duckdb/optimizer/optimizer_extension.hpp"
+
+#ifdef DUCKDB_JOIN_EXTENSION_STANDALONE
+#include <iostream>
+#include <stdexcept>
+#define TEST_CASE(name, tags) static void RunHookTests()
+#define REQUIRE(condition)                                                                                             \
+	do {                                                                                                               \
+		if (!(condition))                                                                                              \
+			throw std::runtime_error(#condition);                                                                      \
+	} while (false)
+#else
+#include "catch.hpp"
+#endif
+
+using namespace duckdb;
+
+namespace {
+enum class TestBehavior { ENUMERATE, NATIVE_FALLBACK, INCOMPLETE, ERROR, CANCEL, NO_PLAN };
+struct HookTestInfo : public OptimizerExtensionInfo {
+	bool enabled = false;
+	idx_t selections = 0;
+	idx_t searches = 0;
+	JoinOrderSearchStage stage = JoinOrderSearchStage::COMPLETE;
+	TestBehavior behavior = TestBehavior::ENUMERATE;
+};
+bool EnumerateTestPlans(JoinOrderSearchContext &context) {
+	context.PrepareSearch();
+	REQUIRE(context.BestCost() == NumericLimits<double>::Maximum());
+	const auto n = context.RelationCount();
+	REQUIRE(n < 8);
+	vector<optional_ptr<JoinRelationSet>> sets(idx_t(1) << n);
+	for (idx_t i = 0; i < n; i++) {
+		sets[idx_t(1) << i] = context.GetRelation(RelationIndex(i));
+	}
+	for (idx_t mask = 1; mask < sets.size(); mask++) {
+		for (idx_t left = (mask - 1) & mask; left; left = (left - 1) & mask) {
+			const auto right = mask ^ left;
+			if (!sets[left] || !sets[right]) {
+				continue;
+			}
+			auto connections = context.GetQueryGraph().GetConnections(*sets[left], *sets[right]);
+			auto plan = context.EmitPair(*sets[left], *sets[right], connections);
+			if (plan) {
+				sets[mask] = plan->set;
+			}
+		}
+	}
+	return bool(sets.back());
+}
+class HookTestSearch : public JoinOrderSearchAlgorithm {
+public:
+	explicit HookTestSearch(HookTestInfo &info) : info(info) {
+	}
+	bool Search(JoinOrderSearchContext &context) override {
+		info.searches++;
+		switch (info.behavior) {
+		case TestBehavior::NATIVE_FALLBACK:
+			return context.FallbackToNative();
+		case TestBehavior::INCOMPLETE:
+			return true;
+		case TestBehavior::ERROR:
+			throw InvalidInputException("intentional join-search test error");
+		case TestBehavior::CANCEL:
+			context.GetContext().Interrupt();
+			context.GetContext().InterruptCheck();
+			return false;
+		case TestBehavior::NO_PLAN:
+			return false;
+		default:
+			auto &leaf = context.GetRelation(RelationIndex(0));
+			REQUIRE(context.GetPlan(leaf).is_leaf);
+			REQUIRE(context.GetPlan(leaf).cost == 0);
+			REQUIRE(context.GetPlan(leaf).cardinality > 0);
+			return EnumerateTestPlans(context);
+		}
+	}
+
+private:
+	HookTestInfo &info;
+};
+unique_ptr<JoinOrderSearchAlgorithm> SelectHookTest(JoinOrderExtensionInput &input) {
+	auto &info = static_cast<HookTestInfo &>(*input.info);
+	info.selections++;
+	if (!info.enabled || input.stage != info.stage) {
+		return nullptr;
+	}
+	return make_uniq<HookTestSearch>(info);
+}
+void Good(Connection &con, const string &sql) {
+	auto result = con.Query(sql);
+	if (result->HasError()) {
+		throw std::runtime_error(result->GetError());
+	}
+}
+string Plan(Connection &con, const string &sql) {
+	auto result = con.Query("EXPLAIN " + sql);
+	if (result->HasError()) {
+		throw std::runtime_error(result->GetError());
+	}
+	return result->GetValue(1, 0).ToString();
+}
+void Count(Connection &con, const string &sql, int64_t expected) {
+	auto result = con.Query(sql);
+	REQUIRE(!result->HasError());
+	REQUIRE(result->GetValue(0, 0).GetValue<int64_t>() == expected);
+}
+} // namespace
+
+TEST_CASE("Join search extensions select safely at native search boundaries", "[optimizer][join-order-extension]") {
+	DuckDB db(nullptr);
+	Connection con(db);
+	Good(con, "SET threads=1");
+	Good(con, "CREATE TABLE a AS SELECT range AS id FROM range(10)");
+	Good(con, "CREATE TABLE b AS SELECT range AS id FROM range(20)");
+	Good(con, "CREATE TABLE c AS SELECT range AS id FROM range(30)");
+	const string query = "SELECT count(*) FROM a, b, c WHERE a.id=b.id AND b.id=c.id";
+	const auto baseline = Plan(con, query);
+	auto info = make_shared_ptr<HookTestInfo>();
+	OptimizerExtension extension;
+	extension.join_order_function = SelectHookTest;
+	extension.optimizer_info = info;
+	OptimizerExtension::Register(DBConfig::GetConfig(*db.instance), std::move(extension));
+
+	// A declined extension preserves the native result, including the physical plan.
+	REQUIRE(Plan(con, query) == baseline);
+	REQUIRE(info->selections > 0);
+	REQUIRE(info->searches == 0);
+	Count(con, query, 10);
+
+	info->enabled = true;
+	info->stage = JoinOrderSearchStage::APPROXIMATE;
+	Good(con, "SET approximate_join_order_threshold=1000");
+	REQUIRE(Plan(con, query) == baseline);
+	REQUIRE(info->searches == 0);
+	Good(con, "SET approximate_join_order_threshold=0");
+	Count(con, query, 10);
+	REQUIRE(info->searches == 1);
+
+	info->stage = JoinOrderSearchStage::COMPLETE;
+	Good(con, "SET approximate_join_order_threshold=1000");
+	Count(con, query, 10);
+	REQUIRE(info->searches == 2);
+	// Native reconstruction retains predicates and validates non-inner join sides.
+	Count(con, "SELECT count(*) FROM a LEFT JOIN b ON a.id=b.id LEFT JOIN c ON b.id=c.id", 10);
+	Count(con, "SELECT count(*) FROM a,b,c WHERE a.id+b.id=c.id", 200);
+	Count(con, "SELECT count(*) FROM a,b,c", 6000);
+	Good(con, "SET debug_force_no_cross_product=true");
+	auto cross_product = con.Query("SELECT count(*) FROM a,b,c");
+	REQUIRE(cross_product->HasError());
+	Good(con, "SET debug_force_no_cross_product=false");
+
+	const auto selected = info->selections;
+	Good(con, "SET disabled_optimizers='extension'");
+	REQUIRE(Plan(con, query) == baseline);
+	REQUIRE(info->selections == selected);
+	Good(con, "SET disabled_optimizers=''");
+
+	info->behavior = TestBehavior::NATIVE_FALLBACK;
+	Count(con, query, 10);
+	Good(con, "SET approximate_join_order_threshold=0");
+	Count(con, query, 10);
+	info->behavior = TestBehavior::INCOMPLETE;
+	auto incomplete = con.Query(query);
+	REQUIRE(incomplete->HasError());
+	REQUIRE(incomplete->GetError().find("without a complete plan") != string::npos);
+	info->behavior = TestBehavior::ERROR;
+	auto error = con.Query(query);
+	REQUIRE(error->HasError());
+	REQUIRE(error->GetError().find("intentional join-search") != string::npos);
+	info->behavior = TestBehavior::CANCEL;
+	auto cancelled = con.Query(query);
+	REQUIRE(cancelled->HasError());
+	REQUIRE(cancelled->GetError().find("Interrupt") != string::npos);
+	info->behavior = TestBehavior::NO_PLAN;
+	Count(con, query, 10);
+	info->enabled = false;
+	REQUIRE(Plan(con, query) == baseline);
+
+	// Registration order is deterministic; the next factory can handle a decline.
+	auto second = make_shared_ptr<HookTestInfo>();
+	second->enabled = true;
+	OptimizerExtension next;
+	next.join_order_function = SelectHookTest;
+	next.optimizer_info = second;
+	OptimizerExtension::Register(DBConfig::GetConfig(*db.instance), std::move(next));
+	Count(con, query, 10);
+	REQUIRE(second->searches == 1);
+	info->enabled = true;
+	info->behavior = TestBehavior::ENUMERATE;
+	Count(con, query, 10);
+	REQUIRE(second->searches == 1);
+}
+
+#ifdef DUCKDB_JOIN_EXTENSION_STANDALONE
+int main() {
+	try {
+		RunHookTests();
+		std::cout << "Join-search hook contract tests passed\n";
+		return 0;
+	} catch (const std::exception &error) {
+		std::cerr << error.what() << '\n';
+		return 1;
+	}
+}
+#endif
