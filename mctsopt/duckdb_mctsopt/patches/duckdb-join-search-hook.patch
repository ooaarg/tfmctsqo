+ClientContext &JoinOrderSearchContext::GetContext() {
+	return enumerator.query_graph_manager.context;
+}
+idx_t JoinOrderSearchContext::RelationCount() const {
+	return enumerator.query_graph_manager.relation_manager.NumRelations();
+}
+const QueryGraphEdges &JoinOrderSearchContext::GetQueryGraph() const {
+	return enumerator.query_graph;
+}
+const DPJoinNode &JoinOrderSearchContext::GetPlan(JoinRelationSet &set) const {
+	return *enumerator.plans.at(set);
+}
+JoinRelationSet &JoinOrderSearchContext::GetRelation(RelationIndex index) {
+	return enumerator.query_graph_manager.set_manager.GetJoinRelation(index);
+}
+bool JoinOrderSearchContext::IsConnectionApplicable(const NeighborInfo &connection, const JoinRelationSet &left,
+                                                    const JoinRelationSet &right) const {
+	return enumerator.query_graph_manager.IsConnectionApplicable(connection, left, right);
+}
+optional_ptr<DPJoinNode> JoinOrderSearchContext::EmitPair(JoinRelationSet &left, JoinRelationSet &right,
+                                                          const vector<reference<NeighborInfo>> &connections) {
+	if (!connections.empty()) {
+		return enumerator.EmitPair(left, right, connections);
+	}
+	auto native_connections = enumerator.GetConnections(left, right);
+	if (native_connections.empty() && enumerator.query_graph_manager.CanCreateCrossProduct(left, right)) {
+		enumerator.query_graph_manager.CreateQueryGraphCrossProduct(left, right);
+		enumerator.connection_cache.clear();
+		native_connections = enumerator.GetConnections(left, right);
+	}
+	return enumerator.EmitPair(left, right, native_connections);
+}
+void JoinOrderSearchContext::PrepareSearch() {
+	for (auto entry = enumerator.plans.begin(); entry != enumerator.plans.end();) {
+		if (!entry->second->is_leaf) {
+			entry = enumerator.plans.erase(entry);
+		} else {
+			++entry;
+		}
+	}
+	enumerator.ActivateRequiredCrossProducts();
+}
+bool JoinOrderSearchContext::FallbackToNative() {
+	PrepareSearch();
+	auto threshold = Settings::Get<ApproximateJoinOrderThresholdSetting>(GetContext());
+	if (RelationCount() < threshold && enumerator.SolveJoinOrderExactly() && enumerator.HasCompletePlan()) {
+		return true;
+	}
+	return enumerator.SolveJoinOrderApproximately() && enumerator.HasCompletePlan();
+}
+double JoinOrderSearchContext::BestCost() const {
+	for (auto &entry : enumerator.plans) {
+		if (entry.first.get().count == RelationCount()) {
+			return entry.second->cost;
+		}
+	}
+	return NumericLimits<double>::Maximum();
+}
+
 } // namespace duckdb
