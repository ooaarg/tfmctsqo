+		}
+		JoinOrderSearchContext search(*this);
+		bool solved = algorithm->Search(search);
+		if (solved && !HasCompletePlan()) {
+			throw InvalidInputException("Join-order extension reported success without a complete plan");
+		}
+		return solved;
+	}
+	return {};
+}
