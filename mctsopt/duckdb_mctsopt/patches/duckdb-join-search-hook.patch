+#pragma once
+
+#include "duckdb/common/common.hpp"
+#include "duckdb/optimizer/join_order/join_node.hpp"
+#include "duckdb/optimizer/join_order/query_graph.hpp"
+
+namespace duckdb {
+class ClientContext;
+class PlanEnumerator;
+struct OptimizerExtensionInfo;
+
+enum class JoinOrderSearchStage : uint8_t { COMPLETE, APPROXIMATE };
+
+// Selection is separate from execution: declining cannot mutate the search memo.
+struct JoinOrderExtensionInput {
+	ClientContext &context;
+	idx_t relation_count;
+	JoinOrderSearchStage stage;
+	optional_ptr<OptimizerExtensionInfo> info;
+};
+
+// Valid only for the duration of one search. Native legality and costing stay in DuckDB.
+class JoinOrderSearchContext {
+	friend class PlanEnumerator;
+	explicit JoinOrderSearchContext(PlanEnumerator &enumerator) : enumerator(enumerator) {
+	}
+
+public:
+	ClientContext &GetContext();
+	idx_t RelationCount() const;
+	const QueryGraphEdges &GetQueryGraph() const;
+	//! Read the current memo entry; references expire when another pair is emitted.
+	const DPJoinNode &GetPlan(JoinRelationSet &set) const;
+	JoinRelationSet &GetRelation(RelationIndex index);
+	bool IsConnectionApplicable(const NeighborInfo &connection, const JoinRelationSet &left,
+	                            const JoinRelationSet &right) const;
+	optional_ptr<DPJoinNode> EmitPair(JoinRelationSet &left, JoinRelationSet &right,
+	                                  const vector<reference<NeighborInfo>> &connections);
+	//! Keep only native leaf plans and enable required graph edges, without enumerating plans.
+	void PrepareSearch();
+	//! Discard external plans and run native search without selecting extensions again.
+	bool FallbackToNative();
+	double BestCost() const;
+
+private:
+	PlanEnumerator &enumerator;
+};
+
+class JoinOrderSearchAlgorithm {
+public:
+	virtual ~JoinOrderSearchAlgorithm() = default;
+	// True requires a complete native plan. False retains the original logical tree.
+	// Errors and cancellation propagate; neither silently selects a different algorithm.
+	virtual bool Search(JoinOrderSearchContext &context) = 0;
+};
+using join_order_function_t = unique_ptr<JoinOrderSearchAlgorithm> (*)(JoinOrderExtensionInput &input);
+} // namespace duckdb
